#version 450
// One workgroup normalizes one full query row. Scores stay in device memory.
layout(local_size_x=64) in;
layout(binding=0,std430) buffer Scores {float values[];};
layout(push_constant) uniform Params {uint keys; float scale; int queryOffset;} p;
shared float partial[64];
void main(){
    uint lane=gl_LocalInvocationIndex, base=gl_WorkGroupID.x*p.keys;
    uint valid=p.queryOffset<0?p.keys:min(p.keys,uint(p.queryOffset)+gl_WorkGroupID.x+1);
    float m=-3.402823e38;
    for(uint k=lane;k<valid;k+=64)m=max(m,values[base+k]*p.scale);
    partial[lane]=m;
    barrier();
    for(uint s=32;s>0;s/=2){if(lane<s)partial[lane]=max(partial[lane],partial[lane+s]);barrier();}
    m=partial[0];
    barrier();
    float sum=0;
    for(uint k=lane;k<p.keys;k+=64){
        float v=k<valid?exp(values[base+k]*p.scale-m):0;
        values[base+k]=v;
        sum+=v;
    }
    partial[lane]=sum;
    barrier();
    for(uint s=32;s>0;s/=2){if(lane<s)partial[lane]+=partial[lane+s];barrier();}
    float inv=1.0/partial[0];
    for(uint k=lane;k<p.keys;k+=64)values[base+k]*=inv;
}
